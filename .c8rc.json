{
  "all": true,
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.d.ts",
    "src/**/__tests__/**",
    "src/core/types.ts",
    "src/core/registry.ts",
    "src/core/registered-types.ts",
    "src/core/attach-types.ts",
    "src/actions/types.ts",
    "src/manager/types.ts",
    "src/react/types.ts",
    "src/solid/types.ts",
    "src/vanilla/types.ts",
    "src/react.ts",
    "src/solid.ts",
    "src/vanilla.ts",
    "src/react/**",
    "src/solid/**",
    "src/vanilla/**",
    "src/core/dialog-styles.ts",
    "src/core/attach-click-outside.ts",
    "src/core/attach-focus-containment.ts",
    "src/core/attach-focus.ts",
    "src/core/attach-keydown.ts",
    "src/core/attach-lifecycle.ts",
    "src/core/dialog-lifecycle.ts",
    "src/core/focus-policy.ts",
    "src/utils/dialog-scope.ts"
  ],
  "reporter": ["text-summary", "html", "lcov", "json"],
  "reportsDir": "coverage",
  "checkCoverage": false
}
