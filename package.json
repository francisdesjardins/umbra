{
  "name": "umbra",
  "version": "1.0.0",
  "description": "Framework-agnostic dialog/modal manager on the native <dialog> top layer, zero shipped UI — with a React binding (useModal plus template hooks) on ./react.",
  "keywords": [
    "dialog",
    "modal",
    "headless",
    "framework-agnostic",
    "vanilla-js",
    "react",
    "hooks",
    "popover",
    "overlay",
    "accessible",
    "a11y",
    "typescript"
  ],
  "author": "Francis Desjardins <francis.desjardins@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francisdesjardins/umbra.git"
  },
  "homepage": "https://francisdesjardins.ca/playground/dialog/",
  "bugs": {
    "url": "https://github.com/francisdesjardins/umbra/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./react": {
      "types": "./dist/esm/react.d.ts",
      "import": "./dist/esm/react.js",
      "default": "./dist/esm/react.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "Chrome >= 138"
  ],
  "scripts": {
    "dev": "yarn workspace umbra-playground dev",
    "build": "yarn build:clean && yarn build:esm",
    "build:clean": "rimraf dist",
    "build:esm": "node node_modules/typescript-7/bin/tsc --noEmit && vite build --config vite.config.esm.ts && yarn build:types",
    "build:types": "node node_modules/typescript-7/bin/tsc -p tsconfig.build.json",
    "playground:build": "yarn workspace umbra-playground build",
    "playground:build:file": "yarn workspace umbra-playground build:file",
    "playground:preview": "yarn workspace umbra-playground preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "lint:oxlint": "oxlint",
    "lint:eslint": "eslint .",
    "check": "yarn type-check && yarn lint && yarn format:check && yarn docs:check && yarn docs:examples",
    "docs:api": "typedoc --options typedoc.json",
    "docs:examples": "node scripts/check-examples.mjs",
    "docs:examples:fix": "node scripts/check-examples.mjs --fix",
    "docs:check": "typedoc --options typedoc.json --emit none",
    "ncu": "npm-check-updates",
    "verify:all": "yarn lint && yarn type-check && yarn build && yarn verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "preview": "vite preview --outDir dist",
    "test": "playwright test -c playwright.config.ts",
    "test:ui": "playwright test -c playwright.config.ts --ui",
    "test:unit": "playwright test -c playwright.config.ts --project=unit",
    "test:unit:coverage": "c8 playwright test -c playwright.config.ts --project=unit",
    "test:unit:ui": "playwright test -c playwright.config.ts --project=unit --ui",
    "test:component": "playwright test -c playwright.config.ts --project=component",
    "test:component:ui": "playwright test -c playwright.config.ts --project=component --ui",
    "type-check:watch": "node node_modules/typescript-7/bin/tsc --noEmit --watch",
    "type-check": "node node_modules/typescript-7/bin/tsc --noEmit && node node_modules/typescript-7/bin/tsc -p playground/tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "c8": "12.0.0",
    "cross-env": "10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.77.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "npm-check-updates": "23.0.1",
    "oxlint": "^1.77.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.3",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  },
  "packageManager": "yarn@4.18.0"
}
