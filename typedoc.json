{
  "$schema": "https://typedoc.app/schema.json",

  // **Validation only.** There is no HTML output: `docs/api` was generated by a `docs:api` script
  // nothing ran and nothing consumed, so the whole rendering half is gone. What typedoc still does
  // here is `docs:check` — the two validations below — and the JSON model behind the playground's
  // `/api` page.
  "entryPoints": ["src/index.ts", "src/react.ts", "src/solid.ts", "src/vanilla.ts"],
  "name": "Dialog Manager",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "intentionallyNotExported": [
    "StoreBase",
    "LowercaseLetter",
    "ModalInfoBase",
    "BaseRenderContext",
    "TemplateBaseOptions",
    "RegisteredStore",
    // The derived-from-the-DOM key list behind `DialogStyle`. It has no name a user would ever
    // write; the type built from it does.
    "umbra/src/core/style.ts:CssPropertyName",
    // The generic model each binding instantiates. A reader reaches these through `./react` or
    // `./solid`, where they appear under the same names with the framework's own style and node
    // types filled in — documenting the open form as well would put two `UseModalOptions` in the
    // reference and make the reader pick.
    "umbra/src/core/types.ts:ModalAnimation",
    "umbra/src/core/types.ts:UseModalBaseOptions",
    "umbra/src/core/types.ts:UseModalOptions",
    "umbra/src/core/types.ts:UseModalReturn",
    // The same model as a *declared* id sees it, and the same reason: these are `UseModalOptions`,
    // `UseModalReturn` and their parts with the registry's correlated close filled in, so
    // documenting them too would put two of each in the reference and make the reader pick. A
    // consumer meets them only as the resolved shape their own call site returns.
    "umbra/src/core/registered-types.ts:AwaitedCloseOf",
    "umbra/src/core/registered-types.ts:RegisteredOptions",
    "umbra/src/core/registered-types.ts:RegisteredReturn",
    "umbra/src/manager/dialog-manager.ts:RegisteredOpenRequestOutcome",
    "umbra/src/templates/shared.ts:RegisteredTemplateOptions",
    "RegisteredMessageContext",
    "RegisteredSlideContext",
    // Internal to the type that reads it: the one place `closes` is destructured, and the four
    // public types derived from it are what a reader wants instead.
    "umbra/src/core/registry.ts:ClosesWithOf",
    // The controller binding's own four options, named only so its registered door can rebuild the
    // option surface without omitting across `ModalVariant`.
    "umbra/src/vanilla/types.ts:BindDialogOwnOptions",
    "umbra/src/vanilla/types.ts:RegisteredBindOptions",
    "umbra/src/vanilla/types.ts:RegisteredController"
  ],
  "disableSources": false,
  "treatWarningsAsErrors": true
}
