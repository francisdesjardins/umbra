{
  "$schema": "https://typedoc.app/schema.json",
  "entryPoints": ["src/index.ts", "src/react.ts"],
  "out": "docs/api",
  "name": "Dialog Manager",
  "includeVersion": true,
  "readme": "README.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "searchInComments": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "intentionallyNotExported": [
    "StoreBase",
    "LowercaseLetter",
    "ModalInfoBase",
    "BaseRenderContext",
    "TemplateBaseOptions",
    "SnapshotOf",
    "RegisteredStore"
  ],
  "disableSources": false,
  "treatWarningsAsErrors": true
}
